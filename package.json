{
  "name": "pink-bun-winefox",
  "version": "0.1.0",
  "private": true,
  "description": "Satou Matsuzaka YSM adaptation by puemmth, based on Wine Fox JK.",
  "author": "puemmth",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.cjs && npm run build:aunt",
    "build:aunt": "node src/build-aunt.cjs",
    "check": "node scripts/check.cjs",
    "test": "npm run build && npm run check",
    "dev": "node scripts/dev.cjs",
    "install:model": "npm run build && node scripts/install.cjs",
    "pack": "npm test && node scripts/pack.cjs",
    "pack:aunt": "node src/build-aunt.cjs --pack",
    "build:viewer": "npm run build && node scripts/build-viewer.cjs",
    "viewer": "npm run build:viewer && node scripts/serve-viewer.cjs",
    "check:viewer": "node scripts/check-viewer.mjs",
    "export:viewer": "npm run build:viewer && node scripts/export-viewer.cjs"
  }
}
